# Nebius Token Factory. Never commit a real key.
NEBIUS_API_KEY=

# NVIDIA open model required by the Nebius x NVIDIA hackathon build.
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b

# Hard-capped in nebius.py at 700 to prevent accidental unbounded output.
NEBIUS_MAX_TOKENS=500

# Opt in explicitly. Default demo remains zero-network deterministic mode.
RUN_NEBIUS=0
