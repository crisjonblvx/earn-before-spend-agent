# Copy to your shell/environment only after human approval.
# Never commit a real key.
MODEL_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL_ID=nvidia/nemotron-3-super-120b-a12b
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# Conservative smoke-test output cap. This limits generated output tokens,
# but does not itself guarantee a dollar-denominated spend ceiling.
MODEL_MAX_TOKENS=350
MODEL_TEMPERATURE=0

# Live test must be explicitly opted into by the human operator.
ALLOW_LIVE_NEBIUS_TEST=NO
MAX_LIVE_RUNS=1

# Set YES only after checking promotional coverage and disabled paid usage.
NEBIUS_PROMO_COVERAGE_CONFIRMED=NO
